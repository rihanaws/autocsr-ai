# ─── Database (Neon) ─────────────────────────────────────────────────────────
# Get from: https://console.neon.tech → Project → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Google OAuth (https://console.cloud.google.com → Credentials)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ─── Upstash Redis ───────────────────────────────────────────────────────────
# Get from: https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# ─── Upstash Vector ──────────────────────────────────────────────────────────
# Get from: https://console.upstash.com → Vector → Details
# Dimension: 768 (nomic-embed-text)
UPSTASH_VECTOR_REST_URL="https://xxx.upstash.io"
UPSTASH_VECTOR_REST_TOKEN="your-upstash-vector-token"

# ─── Upstash QStash ──────────────────────────────────────────────────────────
# Get from: https://console.upstash.com → QStash → API Keys
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="your-qstash-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-qstash-next-signing-key"

# ─── Polar (Billing) ─────────────────────────────────────────────────────────
# Get from: https://dashboard.polar.sh → Settings → API
POLAR_ACCESS_TOKEN="polar_at_your-access-token"
POLAR_WEBHOOK_SECRET="your-polar-webhook-secret"
# Get product IDs from: Polar dashboard → Products
POLAR_PRODUCT_ID_STARTER="prod_your-starter-product-id"
POLAR_PRODUCT_ID_GROWTH="prod_your-growth-product-id"
POLAR_PRODUCT_ID_ENTERPRISE="prod_your-enterprise-product-id"

# ─── Resend (Email) ──────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_your-resend-api-key"

# ─── Inference Service ───────────────────────────────────────────────────────
# Local dev: http://localhost:8000 | Prod: Railway service URL
INFERENCE_SERVICE_URL="http://localhost:8000"
INFERENCE_API_SECRET="replace-with-shared-secret-for-inference-auth"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
