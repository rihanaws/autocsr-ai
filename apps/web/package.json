{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint app components lib types",
    "typecheck": "tsc --noEmit",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "email:dev": "email dev --dir emails --port 3001",
    "setup:okbet": "bun --env-file=.env.local run scripts/setup-okbet-tenant.ts",
    "cron:register": "dotenv -e .env.local -- bun run scripts/register-qstash-cron.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.2",
    "@base-ui/react": "^1.5.0",
    "@neondatabase/serverless": "^0.10.4",
    "@polar-sh/sdk": "^0.47.1",
    "@prisma/adapter-neon": "^6.3.1",
    "@prisma/client": "^6.3.1",
    "@react-email/components": "^1.0.12",
    "@tailwindcss/postcss": "^4.3.0",
    "@upstash/qstash": "^2.7.20",
    "@upstash/redis": "^1.34.3",
    "@upstash/vector": "^1.1.6",
    "ai": "^5.0.52",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.17.0",
    "motion": "^11.15.0",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.25",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "shadcn": "^4.10.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.4.1",
    "eslint-config-next": "^16.2.7",
    "prisma": "^6.3.1",
    "react-email": "^6.5.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3"
  }
}
