## PII Anonymization — Run Before Any Write

```typescript
// anonymizer.ts — apply to ALL text before storage
function anonymize(text: string): string {
  return text
    .replace(/\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,}\b/g, '[EMAIL]')
    .replace(/\b\d{10,16}\b/g, '[ACCOUNT_ID]')
    .replace(/(?:my name is|i am|this is)\s+([A-Z][a-z]+ ?[A-Z]?[a-z]*)/gi, 'customer name is [NAME]')
    .replace(/\+?[\d\s\-().]{10,}/g, '[PHONE]')
    // Keep amount RANGES — important training signal for deposit queries
    .replace(/(?:BDT|USD|INR|৳|\$)\s*([\d,]+(?:\.\d{2})?)/gi, (_, n) => {
      const num = parseFloat(n.replace(/,/g, ''))
      if (num < 1000)  return '[AMT_SM]'   // < 1K
      if (num < 10000) return '[AMT_MD]'   // 1K–10K
      return '[AMT_LG]'                     // > 10K
    })
}
```

