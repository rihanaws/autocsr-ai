## Prisma Patterns

### Always use the singleton
```typescript
// ✅
import { db } from '@/lib/db'

// ❌ Never instantiate directly
import { PrismaClient } from '@prisma/client'
const prisma = new PrismaClient()
```

### Select only what you need
```typescript
// ✅ Explicit select — faster, smaller payload
const tenant = await db.tenant.findUniqueOrThrow({
  where:  { id: tenantId },
  select: { tier: true, apiKey: true },
})

// ❌ Fetches everything including relations
const tenant = await db.tenant.findUnique({ where: { id: tenantId } })
```

### Batch parallel queries
```typescript
// ✅ Parallel — both run simultaneously
const [tenant, usage] = await Promise.all([
  db.tenant.findUniqueOrThrow({ where: { id: tenantId } }),
  db.queryEvent.count({ where: { tenantId, cacheHit: false } }),
])

// ❌ Sequential — twice as slow
const tenant = await db.tenant.findUniqueOrThrow(...)
const usage  = await db.queryEvent.count(...)
```

### Transactions for multi-step writes
```typescript
await db.$transaction([
  db.queryEvent.create({ data: { ...eventData } }),
  db.trainingExample.create({ data: { ...exampleData } }),
])
```

### Error handling
```typescript
import { Prisma } from '@prisma/client'

try {
  await db.tenant.create({ data: { slug } })
} catch (e) {
  if (e instanceof Prisma.PrismaClientKnownRequestError) {
    if (e.code === 'P2002') {
      // Unique constraint violation — slug already taken
      return { error: 'That company slug is already in use' }
    }
  }
  throw e  // re-throw unexpected errors
}
```

